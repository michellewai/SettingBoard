<main class="gym">
  <h1>Setting Board</h1>

  <svg class="floor-plan" viewBox="<%= FloorPlan::VIEW_BOX %>" role="img" aria-label="Gym wall map">
    <% @wall_sections.each do |section| %>
      <% wall = FloorPlan.wall_for(section) %>
      <% routes = section.routes.sort_by(&:id) %>
      <% status, reset = reset_status(section) %>
      <g class="wall <%= "wall--reset-#{status}" if status %>" style="--wall-colour: <%= wall.colour %>">
        <% if status %>
          <polyline class="reset-halo" points="<%= wall.svg_points %>"><title><%= reset_note(status, reset) %></title></polyline>
        <% end %>
        <polyline points="<%= wall.svg_points %>" />
        <a href="#<%= dom_id(section) %>">
          <text class="wall-label" x="<%= wall.label_at[0] %>" y="<%= wall.label_at[1] %>"><%= section.name %></text>
        </a>
        <% routes.zip(wall.marker_positions(routes.size)).each do |route, (x, y)| %>
          <g class="route-marker <%= "route-marker--light" if route.light_colour? %>" style="--route-colour: <%= route.css_colour %>">
            <title><%= "#{route.grade_label} #{route.colour} – set by #{route.setter.name} on #{l(route.set_date, format: :long)}" %></title>
            <circle cx="<%= x %>" cy="<%= y %>" r="10" />
            <text x="<%= x %>" y="<%= y %>"><%= route.grade_label %></text>
          </g>
        <% end %>
      </g>
    <% end %>
  </svg>

  <div class="sections">
    <% @wall_sections.each do |section| %>
      <section class="section" id="<%= dom_id(section) %>" style="--wall-colour: <%= FloorPlan.wall_for(section).colour %>">
        <h2><%= section.name %> <small><%= pluralize(section.routes.size, "route") %></small></h2>
        <% status, reset = reset_status(section) %>
        <% if status %>
          <p class="reset-note reset-note--<%= status %>"><%= reset_note(status, reset) %></p>
        <% end %>
        <% if section.routes.any? %>
          <table>
            <thead>
              <tr><th>Grade</th><th>Colour</th><th>Setter</th><th>Set</th></tr>
            </thead>
            <tbody>
              <% section.routes.sort_by(&:id).each do |route| %>
                <tr>
                  <td><%= route.grade_label %></td>
                  <td><span class="swatch" style="--route-colour: <%= route.css_colour %>"></span><%= route.colour %></td>
                  <td><%= route.setter.name %></td>
                  <td><%= l(route.set_date, format: :short) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="empty">No routes set.</p>
        <% end %>
      </section>
    <% end %>
  </div>
</main>
